  <ItemGroup>
    <Inf Include="WinMaliKmd.inx" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="WinMaliKmd.rc" />
  </ItemGroup>
  <!--
    Vulkan loader manifest JSONs - one per process bitness/emulator.
    These travel into the driver package via the INF's CopyFiles
    section but they're authored as source-tree files; declaring them
    here makes the KMD project track them so VS rebuilds the package
    when the manifests change. CopyToOutputDirectory lands them next
    to WinMaliKmd.sys / .inf at link time, which is where InfVerif and
    Inf2cat look.
  -->
  <ItemGroup>
    <None Include="WinMaliVk_icd.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DeploymentContent>true</DeploymentContent>
    </None>
    <None Include="WinMaliVk_icd_x86.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DeploymentContent>true</DeploymentContent>
    </None>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!-- WDK's Shared.Props (imported by Microsoft.Cpp.targets) defaults
       ApiValidator_Enable and EnableInf2cat back to true when empty,
       which silently overrides the early PropertyGroup. Force the final
       value AFTER all imports. Override via /p:ApiValidator_Enable=true
       (etc.) when you really need them. -->
  <PropertyGroup>
    <ApiValidator_Enable>$(ApiValidator_Enable)</ApiValidator_Enable>
    <EnableInf2cat>$(EnableInf2cat)</EnableInf2cat>
  </PropertyGroup>

</Project>
