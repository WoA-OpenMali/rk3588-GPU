<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <!-- x64 exists ONLY as a dev-box compile-test. The RK3588 is aarch64;
         we never load a x64 .sys on hardware. Keeping x64 lets CI boxes
         without the ARM64 WDK libs still smoke-test the source. -->
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{B1B2C3D4-0001-4E5F-9A0B-001122334455}</ProjectGuid>
    <TemplateGuid>{497e31cb-056b-4f31-abb8-447fd55ee5a5}</TemplateGuid>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <MinimumVisualStudioVersion>12.0</MinimumVisualStudioVersion>
    <Configuration>Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">ARM64</Platform>
    <RootNamespace>WinMaliKmd</RootNamespace>
    <ProjectName>WinMaliKmd</ProjectName>
    <WindowsTargetPlatformVersion>$(LatestTargetPlatformVersion)</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'" Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'" Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <!-- Desktop, not Universal: Universal demands the Spectre CRT which a
         stock x64 dev box usually lacks. -->
    <DriverTargetPlatform>Desktop</DriverTargetPlatform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <DriverTargetPlatform>Desktop</DriverTargetPlatform>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- WinMali.Common.props pins OutDir/IntDir to $(repo)\build\... and
       disables the WDK packaging tasks (InfVerif/ApiValidator/Inf2Cat/
       SignTool) that aren't installed on a stock dev box. -->
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
    <Import Project="..\WinMali.Common.props" />
  </ImportGroup>

  <PropertyGroup>
    <TargetName>WinMaliKmd</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <PreprocessorDefinitions>_WIN64;WIN32_LEAN_AND_MEAN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)..\Shared;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <!-- WDDM miniports link against displib.lib (DxgkInitialize / DxgkCb*).
           $(DDK_LIB_PATH) expands to the right km\<arch> directory inside
           the active WDK. The dxgkrnl.lib / dxapi.lib pair from legacy XDDM
           samples is no longer shipped. -->
      <AdditionalDependencies>$(DDK_LIB_PATH)displib.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
    <!--
      NOTE: NO <Inf><TimeStamp>...</TimeStamp></Inf> here on purpose.
      The InfStamp task PREPENDS its timestamp to the existing DriverVer
      line; if WinMaliKmd.inx already has "DriverVer = <date>,<version>"
      the result is a malformed double date like
      "DriverVer = 05/17/2026,05/17/2026,0.0.1.0". Keep the date in the
      .inx where humans can see it, leave InfStamp out of the way.
    -->
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClInclude Include="WinMaliKmd.h" />
    <ClInclude Include="WinMaliDxgkInitFill.h" />
    <ClInclude Include="..\Shared\WinMaliCommon.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="WinMaliDriver.c" />
    <ClCompile Include="WinMaliDxgkInitFill.c" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="WinMaliKmd.inx" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!-- WDK's Shared.Props (imported by Microsoft.Cpp.targets) defaults
       ApiValidator_Enable and EnableInf2cat back to true when empty,
       which silently overrides the early PropertyGroup. Force the final
       value AFTER all imports. Override via /p:ApiValidator_Enable=true
       (etc.) when you really need them. -->
  <PropertyGroup>
    <ApiValidator_Enable>$(ApiValidator_Enable)</ApiValidator_Enable>
    <EnableInf2cat>$(EnableInf2cat)</EnableInf2cat>
  </PropertyGroup>

</Project>
