  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
  <!-- After WDK props: Shared.Props defaults ApiValidator_Enable and EnableInf2cat to
       true when empty, undoing the early PropertyGroup. Force local defaults; use
       /p:ApiValidator_Enable=true or /p:EnableInf2cat=true from the command line when needed. -->
  <PropertyGroup>
    <ApiValidator_Enable>false</ApiValidator_Enable>
    <EnableInf2cat>false</EnableInf2cat>
  </PropertyGroup>
