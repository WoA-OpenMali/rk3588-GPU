  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <TargetName>WinMaliKmd</TargetName>
    <!-- InfVerif.dll frequently isn't installed on desktop-SDK-only boxes
         (it ships with the full WDK workload). Skip the task by default;
         pass /p:SkipPackageVerification=false to re-enable. -->
    <SkipPackageVerification Condition="'$(SkipPackageVerification)' == ''">true</SkipPackageVerification>
    <!-- ApiValidator / Inf2Cat: WDK Shared.Props defaults these to true when
         empty, so the effective defaults are forced again at the end of this
         file after all Imports. -->
    <ApiValidator_Enable Condition="'$(ApiValidator_Enable)' == ''">false</ApiValidator_Enable>
    <!-- Inf2Cat (catalog generation) requires a fully laid-out package
         directory; for a compile-only smoke build we skip it. It's also
         the biggest source of false positives on desktop-SDK-only
         installs (missing tools, wrong bitness, etc.). -->
    <EnableInf2cat Condition="'$(EnableInf2cat)' == ''">false</EnableInf2cat>
    <!-- SignMode=Off keeps the .sys unsigned at build time. The WDK
         test-signs with a dev cert otherwise, which is handy but not
         required for local iteration. Flip back to TestSign (or pass
         /p:SignMode=TestSign) when you want to load the driver. -->
    <SignMode Condition="'$(SignMode)' == ''">Off</SignMode>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <PreprocessorDefinitions>_WIN64;WIN32_LEAN_AND_MEAN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)hw;$(ProjectDir)diag;$(ProjectDir)..\Shared;$(ProjectDir)..\Shaders;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <SpectreMitigation>false</SpectreMitigation>
    </ClCompile>
    <Link>
      <!-- WDDM miniports link against displib.lib (which exports
           DxgkInitialize / DxgkCb*). The dxgkrnl.lib / dxapi.lib combo
           used by some legacy XDDM samples isn't shipped in the WDK
           anymore. $(DDK_LIB_PATH) expands to the right km\<arch>\ dir. -->
      <AdditionalDependencies>$(DDK_LIB_PATH)displib.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
    <Inf>
      <TimeStamp>04/20/2026,0.0.1.0</TimeStamp>
    </Inf>
  </ItemDefinitionGroup>
  <ItemGroup>
