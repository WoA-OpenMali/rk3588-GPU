<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{B1B2C3D4-0002-4E5F-9A0B-001122334455}</ProjectGuid>
    <RootNamespace>WinMaliUmd</RootNamespace>
    <ProjectName>WinMaliUmd</ProjectName>
    <!-- VS 2017's Platforms\<arch>\ImportBefore\Default\Microsoft.Cpp.WDK.props
         defaults SpectreMitigation to 'Spectre', which forces VC_LibraryPath_*
         to use lib\Spectre\<arch>\ (an optional component not installed on
         this box). Disable here in Globals so it wins before that import. -->
    <SpectreMitigation>false</SpectreMitigation>
    <!-- Pinned to 1809 SDK: this dev box has VS 2017 (v141) + WDK
         10.0.17763.0 only. $(LatestTargetPlatformVersion) on a box
         with a stray newer SDK header set (e.g. 19041 SDK without
         a matching WDK) silently picks the wrong include root. -->
    <WindowsTargetPlatformVersion>10.0.17763.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v141</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v141</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
    <Import Project="..\WinMali.Common.props" />
  </ImportGroup>

  <PropertyGroup>
    <TargetName>WinMaliUmd</TargetName>
    <TargetExt>.dll</TargetExt>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <PreprocessorDefinitions>_WINDOWS;_USRDLL;WINMALIUMD_EXPORTS;WIN32_LEAN_AND_MEAN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- d3dkmthk.h ships in the WDK's km\ tree on 1809 (Microsoft moved
           it to shared\ only in 19041+). The UMD is user-mode but
           d3d10umddi.h pulls d3dkmthk.h in, so we add the km include
           dir explicitly. This is a 1809 wart; remove when we ever
           bump to a newer SDK. -->
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)..\Shared;$(WindowsSdkDir)Include\$(WindowsTargetPlatformVersion)\km;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <CompileAs>CompileAsC</CompileAs>
      <!-- C4201 fires inside the WDK's own d3d10umddi.h (nameless union
           in D3D10DDI_*HANDLE). Nothing we can fix. -->
      <DisableSpecificWarnings>4201;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <ModuleDefinitionFile>WinMaliUmd.def</ModuleDefinitionFile>
      <AdditionalDependencies>kernel32.lib;user32.lib;advapi32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClInclude Include="WinMaliUmd.h" />
    <ClInclude Include="..\Shared\WinMaliCommon.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="WinMaliUmd.c" />
  </ItemGroup>
  <ItemGroup>
    <None Include="WinMaliUmd.def" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
